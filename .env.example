# Copy this file to .env and fill it in:  cp .env.example .env && chmod 600 .env

# --- Blizzard API (create a client at https://develop.battle.net/access/clients) ---
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Region new players default to: us, eu, kr or tw
DEFAULT_REGION=us

# How often to poll every player, in seconds (minimum 60). 300 = 5 minutes.
POLL_INTERVAL_SECONDS=300

# Guild mode: the guild roster (levels, ranks, joins/leaves) is synced every poll.
# Each level-10+ guild member's full profile (item level, last login, avatar) is
# fetched on this slower interval, in seconds. Players added by hand always use
# POLL_INTERVAL_SECONDS.
GUILD_PROFILE_INTERVAL_SECONDS=1800

# --- Admin login ---
# Password for the /admin page. Use something long (at least 12 characters).
ADMIN_PASSWORD=

# --- Site ---
SITE_TITLE=WoW Forever Roster
SITE_SUBTITLE=Our adventurers in World of Warcraft: Forever

# --- Cloudflare Tunnel (Docker setup only) ---
# Zero Trust dashboard -> Networks -> Tunnels -> Create tunnel -> Cloudflared -> copy the token
# (the long string after "--token" in the install command).
TUNNEL_TOKEN=

# --- Server (ignored by docker-compose, which sets these itself) ---
# Keep HOST at 127.0.0.1 when using cloudflared: the tunnel connects locally,
# so the app never needs to be exposed on your network.
HOST=127.0.0.1
PORT=3000

# Where the player list is stored (relative to the app folder, or absolute)
DATA_DIR=./data

# Optional: force a locale for class/race names (e.g. en_US, en_GB, de_DE).
# Leave blank to use the region's default.
LOCALE=
